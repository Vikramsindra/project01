<% layout('layouts/boilerplate') %>


    <!-- <h2>All Listing</h2> -->
    <!-- <form action="/listing/new" method="get">
        <button>Create a new Listing</button>
    </form> -->
    <style>
        #filters {
            display: flex;
            flex-wrap: wrap;
            align-items: center;

        }

        .filter {
            text-align: center;
            margin-right: 2rem;
            margin-top: 2rem;
            opacity: 0.6;
            cursor: pointer;
            color: black;
        }

        .filter:hover {
            opacity: 1;
        }

        .filter p {
            font-size: 0.8rem;
        }

        .filter div i {
            font-size: 1.3rem;
        }

        #filters a {
            text-decoration: none;
        }
        .tax-toggle{
            border: 1px solid black;
            border-radius:1rem ;
            height: 3.5rem;
            padding: 1rem;
            margin-left: 7rem;
            display: flex;
            align-items: center;
        }
        .cardsl{
            margin: 20px;
        }
    </style>
    <div id="filters">
        <a href="listing/category?q=Trending">
            <div class="filter">
                <div><i class="fa-solid fa-fire"></i></div>
                <p>Trending</p>
            </div>
        </a>
        <a href="listing/category?q=Rooms">
            <div class="filter">
                <div><i class="fa-solid fa-bed"></i></div>
                <p>Rooms</p>
            </div>
        </a>
        <a href="listing/category?q=iconic-cities">
            <div class="filter">
                <div><i class="fa-solid fa-city"></i></div>
                <p>Iconic Cities</p>
            </div>
        </a>
        <a href="listing/category?q=Mountains">
            <div class="filter">
                <div><i class="fa-solid fa-mountain-sun"></i></div>
                <p>Mountains</p>
            </div>
        </a>
        <a href="listing/category?q=Castles">
            <div class="filter">
                <div><i class="fab fa-fort-awesome"></i></div>
                <p>Castles</p>
            </div>
        </a>
        <a href="listing/category?q=amazing-pools">
            <div class="filter">
                <div><i class="fa-solid fa-person-swimming"></i></div>
                <p>Amazing Pools
                </p>
            </div>
        </a>
        <a href="listing/category?q=Camping">
            <div class="filter">
                <div><i class="fa-solid fa-campground"></i></div>
                <p>Camping
                </p>
            </div>
        </a>
        <a href="listing/category?q=Farms">
            <div class="filter">
                <div><i class="fa-solid fa-cow"></i></div>
                <p>Farms
                </p>
            </div>
        </a>
        <a href="listing/category?q=Arctic">
            <div class="filter">
                <div><i class="fa-solid fa-snowflake"></i></div>
                <p>Arctic
                </p>
            </div>
        </a>
        <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">Display Total after Taxes</label>
            </div>
        </div>
    </div>


    </div>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3 cardsl">
        <% for(let ob of data) {%>
            <a href="/listing/<%= ob._id%>" class="listing-link">
                <div class="card listing-card col ">
                    <img src=<%=ob.image.url%> class="card-img-top" alt="..."style="height: 20rem;" >
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <p class="card-text">
                            <b>
                                <%= ob.title %>
                            </b>
                            <br>
                            &#8377; <%= ob.price.toLocaleString('en-IN') %>/night
                            <i class="taxes"></i>
                        </p>
                    </div>
                </div>
            </a>

            <% } %>
    </div>

    <script>
        let taxSwitch = document.getElementById('switchCheckDefault');
        const taxes = document.querySelectorAll(".taxes");
        taxSwitch.addEventListener("click",()=>{
            if (taxSwitch.checked) {
                taxes.forEach((e)=>{
            e.innerHTML = "&nbsp;&nbsp;+18% GST";
           })
            }else{
                taxes.forEach((e)=>{
            e.innerHTML = "";
           })
            }
           
        })
    </script>